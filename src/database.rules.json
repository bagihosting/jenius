
{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".indexOn": ["role", "robloxUsername", "bonusPoints"],
      "$uid": {
        ".read": "auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "role": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "bonusPoints": {
           // Validasi: hanya bisa bertambah atau tetap, dan harus angka.
           ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())"
        },
        "lastClaimedAt": {
           // Validasi: Waktu baru harus lebih besar dari waktu lama jika sudah ada.
           ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val()) && newData.val() <= now + 1000"
        }
      }
    },
    "usernames": {
      ".read": "auth.uid != null",
      "$username": {
        // Allow write only if the username doesn't exist and the UID matches the authenticated user.
        ".write": "!data.exists() && newData.child('uid').val() === auth.uid"
      }
    },
    "robloxUsernames": {
      ".read": "auth.uid != null",
      "$username": {
        // Allow write if the username doesn't exist or if it already belongs to the current user.
        ".write": "auth.uid != null && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "upgradeRequests": {
      ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        // Allow user to create a request, but not to overwrite an approved one.
        ".write": "auth.uid === $uid && (!data.exists() || data.child('status').val() !== 'approved')",
        // User can read their own request, admin can read any.
        ".read": "auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "appSettings": {
      ".read": "auth.uid != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "leaderboard": {
      ".read": "auth.uid != null",
      // Leaderboard is only written to by a trusted server process (simulated).
      ".write": false, 
      ".indexOn": "bonusPoints"
    }
  }
}
