
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check for admin role on an existing user document.
      // Assumes 'admins' collection or a 'role' field in user's profile
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USER COLLECTION
    match /users/{userId} {
      // READ:
      // - Any authenticated user can get their own document.
      // - Admins can get any user document.
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());

      // LIST (for Leaderboard):
      // - Allow any authenticated user to list users only if sorted by bonusPoints descending.
      // - This is secure because they can't filter by other fields, only query the leaderboard.
      allow list: if isAuthenticated() && request.query.orderBy[0].field == "bonusPoints";

      // CREATE:
      // - New user must be the owner of the document.
      // - MUST register with 'user' role. Critical security check.
      // - MUST start with 0 bonus points.
      // - All required fields must be present.
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.bonusPoints == 0
                    && 'name' in request.resource.data
                    && 'username' in request.resource.data
                    && 'email' in request.resource.data
                    && 'schoolType' in request.resource.data
                    && 'schoolName' in request.resource.data
                    && 'registeredAt' in request.resource.data
                    && 'quizCompletions' in request.resource.data
                    && 'progress' in request.resource.data;

      // UPDATE:
      // - User is owner OR is admin.
      // - Critical fields (role, bonusPoints) can only be changed by an admin.
      // - Grade can only be set once by the user, then only admin can change.
      // - User can update their own non-critical profile info.
      allow update: if isAuthenticated() && (
        ( // Admin can update anything except their own role.
          isAdmin() && (userId != request.auth.uid || request.resource.data.role == 'admin')
        ) ||
        ( // User can update their own data under these conditions:
          isOwner(userId) &&
          request.resource.data.role == resource.data.role && // Cannot change own role
          request.resource.data.bonusPoints == resource.data.bonusPoints && // Cannot change own bonus points
          (
            // Can set 'grade' if it doesn't exist yet, but cannot change it once set.
            (!('grade' in resource.data) && 'grade' in request.resource.data) ||
            request.resource.data.grade == resource.data.grade
          )
        )
      );

      // DELETE:
      // - Only Admins can delete user documents.
      allow delete: if isAdmin();
    }
    
    // UPGRADE REQUESTS
    match /upgradeRequests/{userId} {
      // User can create their own request.
      allow create: if isOwner(userId);
      // User can see their own request status, Admin can see all.
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Admin can list all requests for management.
      allow list: if isAdmin();
      // Admin can approve/reject (update status).
      allow update: if isAdmin();
      // Admin can delete rejected requests.
      allow delete: if isAdmin();
    }

    // APP SETTINGS
    match /appSettings/{docId} {
      // Anyone can read settings (e.g., to see donation info).
      allow get: if true;
      // Only admins can change app settings.
      allow write: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

    