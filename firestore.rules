rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to make rules cleaner
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check the user's role from their own document in the database.
      // This requires the user to have read access to their own document.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Checks if the data being written is valid for a user document.
    function isValidUserData(data) {
      return data.name is string && data.username is string && data.email is string;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow reading the entire collection (list) only for admins.
      allow list: if isAdmin();
      
      // Users can read their own data. Admins can read any user's data.
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can update their own data. Admins can update any user's data.
      allow update: if (isOwner(userId) || isAdmin())
                    && isValidUserData(request.resource.data)
                    // Validation Rules for updates:
                    // 1. Role can only be changed by an admin.
                    && (request.resource.data.role == resource.data.role || isAdmin())
                    // 2. Bonus points can only be increased or set by an admin.
                    && (request.resource.data.bonusPoints >= resource.data.bonusPoints || isAdmin())
                    // 3. Last claimed time can only be moved forward or set by an admin.
                    && (request.resource.data.lastClaimedAt >= resource.data.lastClaimedAt || isAdmin());

      // New users can create their own document.
      allow create: if isOwner(userId)
                     && isValidUserData(request.resource.data)
                     // Validation on create: Role must be 'user'. Prevents self-promotion to admin.
                     && request.resource.data.role == 'user';
      
      // Admins can delete users. (Regular users cannot delete their own accounts via this rule).
      allow delete: if isAdmin();
    }
    
    // Rules for the 'upgradeRequests' collection
    match /upgradeRequests/{userId} {
        // Users can create and read their own request
        allow create, read: if isOwner(userId);
        // Admins can see all requests and can update/delete them
        allow list, update, delete: if isAdmin();
    }
    
    // Rules for the 'appSettings' collection
    match /appSettings/{setting} {
        // Only admins can read or write application settings
        allow read, write: if isAdmin();
    }
    
    // Rules for the 'leaderboard' collection
    match /leaderboard/{entry} {
      // Any authenticated user can read the leaderboard data.
    	allow read: if isAuthenticated();
      // No client should ever write to the leaderboard directly.
      allow write: if false;
    }
    match /leaderboard/{document=**} {
      // Allow authenticated users to list the documents in the leaderboard collection.
      allow list: if isAuthenticated();
    }
  }
}
