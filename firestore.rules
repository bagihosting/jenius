
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user exists and is an admin.
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow an admin to read/list all user documents.
      allow list, get: if isAdmin();
      
      // Allow a user to read their own document.
      allow get: if request.auth.uid == userId;

      // Allow a user to create their own document (on signup).
      allow create: if request.auth.uid == userId;

      // Allow a user to update their own document, but with restrictions.
      // An admin can update any user document without restrictions.
      allow update: if request.auth.uid == userId 
                      // Prevent a user from changing their own role.
                      && request.resource.data.role == resource.data.role
                    || isAdmin();
    }
    
    // Rules for upgrade requests to 'mahasiswa' role
    match /upgradeRequests/{userId} {
      // Admins can read all requests.
      allow list, get: if isAdmin();
      
      // A user can read their own request.
      allow get: if request.auth.uid == userId;
      
      // A user can create a request for their own UID.
      allow create: if request.auth.uid == userId;
      
      // Only admins can approve, reject (update/delete) requests.
      allow update, delete: if isAdmin();
    }
    
    // Rules for application-wide settings
    match /appSettings/{docId} {
      // Only admins can read or write to app settings.
      allow read, write: if isAdmin();
    }
  }
}
