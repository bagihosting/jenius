
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to make rules cleaner and more readable
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check the role of the user making the request from their own document in Firestore
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // READ: Admins can read any user doc. Users can only read their own.
      allow get: if isOwner(userId) || isAdmin();
      
      // LIST: Only admins can list all users. This prevents users from discovering other users.
      allow list: if isAdmin();

      // CREATE: A user can only create their own document.
      allow create: if isOwner(userId)
                    // Validation on create: Role must be 'user' and bonusPoints must be 0.
                    && request.resource.data.role == 'user'
                    && request.resource.data.bonusPoints == 0;

      // UPDATE: Admins can update any user. Users can only update their own document.
      allow update: if isOwner(userId) || isAdmin();

      // DELETE: Only admins can delete user documents.
      allow delete: if isAdmin();
    }
    
    // Rules for the 'upgradeRequests' collection
    match /upgradeRequests/{userId} {
      // Users can create and read their own request.
      allow create, get: if isOwner(userId);
      
      // Admins can see all requests (list) and can update/delete them.
      allow list, update, delete: if isAdmin();
    }
    
    // Rules for the 'appSettings' collection
    match /appSettings/{setting} {
      // Only admins can read or write application settings.
      allow read, write: if isAdmin();
    }
    
    // Rules for the 'leaderboard' collection, which is a denormalized, public-readable collection.
    match /leaderboard/{document=**} {
      // Any authenticated user can read (get or list) the leaderboard.
      allow read: if isAuthenticated();
      
      // No client should ever write to the leaderboard directly.
      // This should be handled by a trusted server environment (e.g., Cloud Functions).
      allow write: if false;
    }
  }
}
