rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Collection: users
    match /users/{userId} {
      // --- READ ---
      // Allow admin to read any user document.
      // Allow authenticated users to read their own document.
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // --- LIST (for Leaderboard) ---
      // Allow authenticated users to list users ONLY for the leaderboard query.
      // The query MUST be ordered by bonusPoints and limited to 5.
      allow list: if isAuthenticated()
                  && request.query.orderBy[0].field == 'bonusPoints'
                  && request.query.orderBy[0].direction == 'desc'
                  && request.query.limit <= 5;

      // --- CREATE (Registration) ---
      // Allow anyone to create a user document IF:
      // 1. They are creating a document for themselves.
      // 2. The role is explicitly 'user'.
      // 3. bonusPoints is 0.
      // 4. They provide all required fields.
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.bonusPoints == 0
                    && 'name' in request.resource.data
                    && 'username' in request.resource.data
                    && 'email' in request.resource.data
                    && 'schoolType' in request.resource.data
                    && 'schoolName' in request.resource.data;
                   
      // --- UPDATE ---
      // Allow admin to update any user.
      // Allow user to update their own document with restrictions.
      allow update: if isAdmin() || (isOwner(userId)
                    // Users cannot change their own role or bonus points.
                    && !('role' in request.resource.data)
                    && !('bonusPoints' in request.resource.data)
                    // Users can only set their grade if it doesn't exist yet. It's locked after that.
                    && (!('grade' in request.resource.data) || !('grade' in resource.data)));
                    
      // --- DELETE ---
      // Only admin can delete user documents.
      allow delete: if isAdmin();
    }
    
    // Collection: upgradeRequests
    match /upgradeRequests/{userId} {
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow list: if isAuthenticated() && isAdmin();
      
      // User can create their own request. Admin can create/update any.
      allow create: if isAuthenticated() && isOwner(userId);
      allow update, delete: if isAuthenticated() && isAdmin();
    }
    
    // Collection: appSettings
    match /appSettings/{docId} {
      allow get: if isAuthenticated();
      allow list, write: if isAuthenticated() && isAdmin();
    }
  }
}
