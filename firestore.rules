
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      // Check role of the user making the request.
      // Use exists() to prevent errors if the user document doesn't exist yet.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getRole(request.auth.uid) == 'admin';
    }
    
    // ========== COLLECTION: users ==========
    match /users/{userId} {
      // --- READ ---
      // Allow reading own document or if user is an admin.
      allow get: if isOwner(userId) || isAdmin();

      // --- LIST (for leaderboard) ---
      // Allow authenticated users to list users ONLY for the leaderboard query.
      // This is a specific rule to enable the leaderboard feature securely.
      allow list: if isAuthenticated() && request.query.orderBy[0].field == "bonusPoints" && request.query.limit <= 5;
      
      // Allow admin to list all users without restrictions.
      allow list: if isAdmin();
      
      // --- CREATE ---
      // Allow user creation only if the user is the owner of the document.
      allow create: if isOwner(userId) &&
                      // Ensure the role is set to 'user' during creation. Prevents self-promotion to admin.
                      request.resource.data.role == 'user' &&
                      // Ensure bonus points start at 0.
                      request.resource.data.bonusPoints == 0;

      // --- UPDATE ---
      // Allow users to update their own document, with restrictions.
      allow update: if isOwner(userId) &&
                      // A user cannot change their own role.
                      request.resource.data.role == resource.data.role &&
                      // A user cannot change their own bonus points. This must be done by a trusted server/admin.
                      request.resource.data.bonusPoints == resource.data.bonusPoints;
      
      // Admins can update any user document without restrictions.
      allow update: if isAdmin();
      
      // --- DELETE ---
      // Only admins can delete user documents.
      allow delete: if isAdmin();
    }

    // ========== COLLECTION: upgradeRequests ==========
    match /upgradeRequests/{userId} {
      // Users can create and read their own request.
      allow create, get: if isOwner(userId);
      // Admins can see all requests, and update/delete them.
      allow list, update, delete: if isAdmin();
    }

    // ========== COLLECTION: appSettings ==========
    match /appSettings/{setting} {
      // Any authenticated user can read the settings (e.g., to see donation info).
      allow get: if isAuthenticated();
      // Only admins can write application settings.
      allow write: if isAdmin();
    }
  }
}
