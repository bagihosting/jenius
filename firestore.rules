rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    //======================================
    // Helper Functions
    //======================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check if the requesting user has the 'admin' role in their own user document.
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isExistingUser(userId) {
    	return exists(/databases/$(database)/documents/users/$(userId));
    }

    //======================================
    // Collection: users
    //======================================
    match /users/{userId} {
      // --- CREATE ---
      // Anyone can create their own user document (registration).
      // Validation ensures they can't assign themselves special roles or points.
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.bonusPoints == 0;
      
      // --- READ ---
      // Admins can get any user doc. Users can only get their own.
      allow get: if isAdmin() || isOwner(userId);

      // --- UPDATE ---
      // Users can update their own document, but with strict validation.
      // Admins can update any user document without these restrictions.
      allow update: if isAdmin() || (
                      isOwner(userId) &&
                      // Users cannot change their own role, email, or username.
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.email == resource.data.email &&
                      request.resource.data.username == resource.data.username &&
                      // Users cannot directly change their bonus points.
                      request.resource.data.bonusPoints == resource.data.bonusPoints
                    );
      
      // --- DELETE ---
      // Only admins can delete user documents from Firestore.
      allow delete: if isAdmin();
      
      // --- LIST (for Leaderboard) ---
      // This rule specifically allows the leaderboard query.
      // Any authenticated user can list users IF the query is ordered by bonusPoints.
      // This is secure because it doesn't allow arbitrary listing of all users.
      allow list: if isAuthenticated() && request.query.orderBy == 'bonusPoints';
    }
    
    //======================================
    // Collection: upgradeRequests
    //======================================
    match /upgradeRequests/{userId} {
        // Users can create and read their own request.
        allow create, get: if isOwner(userId);
        
        // Admins can see all requests, and update/delete them.
        allow list, update, delete: if isAdmin();
    }
    
    //======================================
    // Collection: appSettings
    //======================================
    match /appSettings/{setting} {
        // Only admins can read or write application settings.
        allow read, write: if isAdmin();
    }
  }
}
