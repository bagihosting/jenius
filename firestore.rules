
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions to make rules cleaner
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // CREATE: Anyone can create a user document (register) IF:
      // 1. They are creating a document for themselves.
      // 2. The role they are assigning is 'user' (cannot self-assign 'admin').
      // 3. bonusPoints must be initialized to 0.
      // 4. All required fields are present.
      allow create: if isOwner(userId) &&
                       request.resource.data.role == 'user' &&
                       request.resource.data.bonusPoints == 0 &&
                       'name' in request.resource.data &&
                       'username' in request.resource.data &&
                       'email' in request.resource.data &&
                       'schoolType' in request.resource.data &&
                       'schoolName' in request.resource.data &&
                       'registeredAt' in request.resource.data &&
                       'quizCompletions' in request.resource.data;

      // GET: Users can get their own data, and Admins can get any user's data.
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // LIST (QUERY): Allow authenticated users to query the user list ONLY for the leaderboard.
      // This is secure because it only allows queries that are ordered by 'bonusPoints'.
      // Other queries on the 'users' collection will be denied.
      allow list: if isAuthenticated() && request.query.orderBy[0].field == 'bonusPoints';
      
      // UPDATE: Allow users to update their own data, but with strict field-level security.
      allow update: if isAuthenticated() &&
                     (
                       // Case 1: An admin is making changes.
                       isAdmin() ||
                       // Case 2: A regular user is making changes to their own document.
                       (
                         isOwner(userId) &&
                         // The user CANNOT change their own role or bonus points.
                         request.resource.data.role == resource.data.role &&
                         request.resource.data.bonusPoints == resource.data.bonusPoints &&
                         // The user cannot change their grade once it's set.
                         (!('grade' in resource.data) || request.resource.data.grade == resource.data.grade) &&
                         // Fields below are the ONLY ones a user is allowed to change.
                         request.resource.data.keys().hasAll(['name', 'username', 'email', 'schoolType', 'schoolName', 'role', 'registeredAt', 'quizCompletions', 'bonusPoints', 'progress', 'photoUrl', 'robloxUsername', 'lastClaimedAt', 'grade', 'major']) &&
                         !request.resource.data.keys().hasAny(['some_other_field'])
                       )
                     ) &&
                     // Data Validation: Ensure data consistency on update for all roles.
                     (
                       request.resource.data.bonusPoints >= 0 &&
                       (request.resource.data.role != 'user' || (request.resource.data.schoolName is string && request.resource.data.schoolType is string)) &&
                       (request.resource.data.role != 'mahasiswa' || request.resource.data.major is string)
                     );

      // DELETE: Only admins can delete users.
      allow delete: if isAdmin();
    }

    match /upgradeRequests/{userId} {
      // User can create and read their own request.
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && 'status' in request.resource.data && request.resource.data.status == 'pending';
      
      // Admin can view all requests and update their status.
      allow list, update: if isAdmin();
      // Admin can also delete rejected/completed requests.
      allow delete: if isAdmin();
    }

    match /appSettings/upgradeInfo {
      // Anyone can read the settings (e.g., to see donation info).
      allow get: if isAuthenticated();
      // Only admins can change the settings.
      allow write: if isAdmin();
    }
    
    // Default deny all other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
