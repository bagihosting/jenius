
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to make rules cleaner
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isExistingUser() {
    	return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can read/write any user document
      // Users can only read/write their own document
      allow read, update, delete: if isAdmin() || isOwner(userId);
      // Anyone can create a user document (for registration) if they are the owner
      allow create: if isOwner(userId);

      // Field-specific validations on write
      allow write: if 
            // Role can only be changed by an admin, and cannot be set by a user during creation
            (request.resource.data.role == resource.data.role || isAdmin()) &&
            // Bonus points can only be increased, not set arbitrarily high or decreased by user
            (request.resource.data.bonusPoints >= resource.data.bonusPoints || isAdmin()) &&
            // Last claimed time can only be moved forward
            (request.resource.data.lastClaimedAt >= resource.data.lastClaimedAt || resource.data.lastClaimedAt == null || isAdmin());
    }
    
    // Rules for reading the entire 'users' collection
    match /users/{document=**} {
        allow list: if isAdmin();
    }
    
    // Rules for the 'upgradeRequests' collection
    match /upgradeRequests/{userId} {
        // Users can create and read their own request
        allow create, read: if isOwner(userId);
        // Admins can see all requests and can update/delete them
        allow list, update, delete: if isAdmin();
    }
    
    // Rules for the 'appSettings' collection
    match /appSettings/{setting} {
        // Only admins can read or write application settings
        allow read, write: if isAdmin();
    }
    
    // Rules for the 'leaderboard' collection
    match /leaderboard/{userId} {
    	// The leaderboard is a public-readable collection, denormalized for performance.
      // Any authenticated user can read it.
    	allow read: if isAuthenticated();
      // No client should ever write to the leaderboard directly.
      // This should be handled by a trusted server environment (e.g., Cloud Functions).
      allow write: if false;
    }
     match /leaderboard/{document=**} {
        allow list: if isAuthenticated();
    }
  }
}
