rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to make rules cleaner and more reusable.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getRole() {
      // Safely get the user's role. Returns 'user' if not found or no role is set.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getRole() == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Users can get their own document, admins can get any.
      allow get: if isOwner(userId) || isAdmin();
      // Admins can list all users.
      allow list: if isAdmin();
      
      // Users can only create their own user document.
      allow create: if isOwner(userId);
      
      // Users can update their own document, admins can update any.
      allow update: if isOwner(userId) || isAdmin();
      
      // Users can delete their own account, admins can delete any.
      allow delete: if isOwner(userId) || isAdmin();

      // Deeper validation on write operations (create, update)
      allow write: if
        // VALIDATION 1: Role Security
        // On create, role must be 'user'.
        // On update, role can only be changed by an admin.
        (request.method == 'create' && request.resource.data.role == 'user') ||
        (request.method == 'update' && (request.resource.data.role == resource.data.role || isAdmin()))
        &&
        // VALIDATION 2: Bonus Points
        // Cannot be negative and can only be increased by the user (or set by admin).
        request.resource.data.bonusPoints >= 0 &&
        (isAdmin() || !exists(resource) || request.resource.data.bonusPoints >= resource.data.bonusPoints)
        &&
        // VALIDATION 3: Last Claimed Time
        // Cannot be set to a future date and can only be moved forward by the user.
        request.resource.data.lastClaimedAt <= request.time &&
        (isAdmin() || !exists(resource) || request.resource.data.lastClaimedAt > resource.data.lastClaimedAt);
    }
    
    // Rules for the 'upgradeRequests' collection
    match /upgradeRequests/{userId} {
      // Users can create and read their own request.
      allow get, create: if isOwner(userId);
      // Admins can see all requests and can update/delete them.
      allow list, update, delete: if isAdmin();
    }
    
    // Rules for the 'appSettings' collection
    match /appSettings/{setting} {
      // Only admins can read or write application settings.
      allow read, write: if isAdmin();
    }
    
    // Rules for the 'leaderboard' collection
    match /leaderboard/{document=**} {
    	// Any authenticated user can read the leaderboard for display purposes.
    	allow read: if isAuthenticated();
      // No client should ever write to the leaderboard directly.
      // This must be handled by a trusted server environment (e.g., Cloud Functions).
      allow write: if false;
    }
  }
}
