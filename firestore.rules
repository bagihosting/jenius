
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // USERS COLLECTION
    // Rules for the 'users' collection
    match /users/{userId} {
    
      // CREATE: Allow any new user to create their own document, but with strict validation.
      allow create: if isAuthenticated()
                      && isOwner(userId)
                      // Validate incoming data to ensure security
                      && request.resource.data.name is string
                      && request.resource.data.username is string
                      && request.resource.data.email == request.auth.token.email
                      && request.resource.data.role == 'user' // Users MUST register as 'user'
                      && request.resource.data.bonusPoints == 0 // Bonus points MUST start at 0
                      && request.resource.data.quizCompletions == 0
                      && request.resource.data.schoolType is string
                      && request.resource.data.schoolName is string
                      && request.resource.data.size() == 9; // Ensure no extra fields are added

      // READ: Users can read their own document. Admins can read any document.
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());

      // UPDATE: Users can update specific fields. Admins can update more fields.
      allow update: if isAuthenticated() && 
                      (
                        // User's own update rules
                        (isOwner(userId) &&
                          // Fields users are allowed to change
                          request.resource.data.name == incomingData().name &&
                          request.resource.data.photoUrl == incomingData().photoUrl &&
                          request.resource.data.robloxUsername == incomingData().robloxUsername &&
                          // Grade can only be set once by the user, if it doesn't exist yet.
                          (!('grade' in resource.data) || resource.data.grade == incomingData().grade) &&
                          // Fields users are NOT allowed to change
                          resource.data.email == incomingData().email &&
                          resource.data.username == incomingData().username &&
                          resource.data.role == incomingData().role &&
                          resource.data.bonusPoints == incomingData().bonusPoints
                        ) 
                        ||
                        // Admin update rules
                        (isAdmin())
                      );
                      
      // DELETE: Only admins can delete user documents.
      allow delete: if isAdmin();
      
      // LIST (for leaderboard): Any authenticated user can list users IF AND ONLY IF
      // the query is for the leaderboard (ordered by bonus points, limited).
      // This prevents fetching all users.
      allow list: if isAuthenticated()
                   && request.query.orderBy == 'bonusPoints desc'
                   && request.query.limit <= 5;
    }
    
    // APPSETTINGS COLLECTION
    // Only admins can read or write app-wide settings.
    match /appSettings/{docId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
    
    // UPGRADEREQUESTS COLLECTION
    // Rules for account upgrade requests.
    match /upgradeRequests/{userId} {
      // READ: Users can get their own request. Admins can get any request.
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // LIST: Only admins can list all requests.
      allow list: if isAuthenticated() && isAdmin();
      
      // CREATE: A user can create their own request.
      allow create: if isAuthenticated() && isOwner(userId);
      
      // UPDATE & DELETE: Only admins can update (approve/reject) or delete requests.
      allow update, delete: if isAuthenticated() && isAdmin();
    }
  }
}
